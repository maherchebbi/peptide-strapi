{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Commandes clients (paiement par virement bancaire)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": { "type": "string", "required": true, "unique": true },
    "status": {
      "type": "enumeration",
      "enum": ["pending_payment", "paid", "shipped", "cancelled"],
      "default": "pending_payment",
      "required": true
    },
    "customerId": { "type": "integer", "required": true },
    "customerEmail": { "type": "email", "required": true },
    "firstName": { "type": "string", "required": true },
    "lastName": { "type": "string", "required": true },
    "phone": { "type": "string", "required": true },
    "shipLine1": { "type": "string", "required": true },
    "shipLine2": { "type": "string" },
    "shipPostalCode": { "type": "string", "required": true },
    "shipCity": { "type": "string", "required": true },
    "shipCountry": { "type": "string", "required": true },
    "notes": { "type": "text" },
    "items": { "type": "json", "required": true },
    "subtotal": { "type": "decimal", "required": true },
    "shippingCost": { "type": "decimal", "required": true },
    "total": { "type": "decimal", "required": true }
  }
}