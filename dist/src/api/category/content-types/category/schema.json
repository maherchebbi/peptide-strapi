{
    "kind": "collectionType",
    "collectionName": "categories",
    "info": {
        "singularName": "category",
        "pluralName": "categories",
        "displayName": "Category",
        "description": "Catégorie du catalogue (boutique)"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "slug": {
            "type": "uid",
            "targetField": "label",
            "required": true
        },
        "label": {
            "type": "string",
            "required": true
        },
        "icon": {
            "type": "string",
            "required": true
        },
        "products": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::product.product",
            "mappedBy": "category"
        }
    }
}
